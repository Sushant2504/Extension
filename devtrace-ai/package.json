{
  "name": "devtrace-ai",
  "displayName": "DevTrace AI",
  "description": "Track and analyze AI prompts across your development team.",
  "version": "0.1.0",
  "publisher": "SushantNadavade",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "prompts",
    "logging",
    "team"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/devtraceai.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/devtraceai/issues"
  },
  "homepage": "https://github.com/your-org/devtraceai",
  "icon": "icon.png",
  "license": "MIT",
  "activationEvents": [
    "onView:devtraceai.promptHistory",
    "onView:devtraceai.teamPatterns"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devtraceai-sidebar",
          "title": "DevTrace AI",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "devtraceai-sidebar": [
        {
          "id": "devtraceai.promptHistory",
          "name": "Prompt History",
          "icon": "$(history)",
          "contextualTitle": "DevTrace AI"
        },
        {
          "id": "devtraceai.teamPatterns",
          "name": "Team Patterns",
          "icon": "$(organization)",
          "contextualTitle": "DevTrace AI"
        },
        {
          "id": "devtraceai.settings",
          "name": "Settings",
          "type": "webview",
          "icon": "$(gear)",
          "contextualTitle": "DevTrace AI"
        }
      ]
    },
    "commands": [
      {
        "command": "devtraceai.logPrompt",
        "title": "DevTrace AI: Log Prompt",
        "icon": "$(add)"
      },
      {
        "command": "devtraceai.refreshPrompts",
        "title": "DevTrace AI: Refresh Prompts",
        "icon": "$(refresh)"
      },
      {
        "command": "devtraceai.filterPrompts",
        "title": "DevTrace AI: Filter Prompts",
        "icon": "$(filter)"
      },
      {
        "command": "devtraceai.clearFilter",
        "title": "DevTrace AI: Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "devtraceai.viewPromptDetail",
        "title": "DevTrace AI: View Prompt Details",
        "icon": "$(open-preview)"
      },
      {
        "command": "devtraceai.editDeveloper",
        "title": "DevTrace AI: Edit Developer Profile",
        "icon": "$(edit)"
      },
      {
        "command": "devtraceai.refreshTeamPatterns",
        "title": "DevTrace AI: Refresh Team Patterns",
        "icon": "$(refresh)"
      },
      {
        "command": "devtraceai.showTeamDashboard",
        "title": "DevTrace AI: Team Patterns Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "devtraceai.checkConnection",
        "title": "DevTrace AI: Check Backend Connection",
        "icon": "$(plug)"
      },
      {
        "command": "devtraceai.searchPrompts",
        "title": "DevTrace AI: Search Prompts",
        "icon": "$(search)"
      },
      {
        "command": "devtraceai.exportPrompts",
        "title": "DevTrace AI: Export Prompts",
        "icon": "$(export)"
      },
      {
        "command": "devtraceai.openSettings",
        "title": "DevTrace AI: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devtraceai.logPrompt",
          "when": "view == devtraceai.promptHistory",
          "group": "navigation@1"
        },
        {
          "command": "devtraceai.filterPrompts",
          "when": "view == devtraceai.promptHistory",
          "group": "navigation@2"
        },
        {
          "command": "devtraceai.clearFilter",
          "when": "view == devtraceai.promptHistory && devtraceai.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "devtraceai.searchPrompts",
          "when": "view == devtraceai.promptHistory",
          "group": "navigation@4"
        },
        {
          "command": "devtraceai.refreshPrompts",
          "when": "view == devtraceai.promptHistory",
          "group": "navigation@5"
        },
        {
          "command": "devtraceai.refreshTeamPatterns",
          "when": "view == devtraceai.teamPatterns",
          "group": "navigation@1"
        },
        {
          "command": "devtraceai.showTeamDashboard",
          "when": "view == devtraceai.teamPatterns",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "devtraceai.viewPromptDetail",
          "when": "view == devtraceai.promptHistory && viewItem == prompt",
          "group": "inline"
        },
        {
          "command": "devtraceai.editDeveloper",
          "when": "view == devtraceai.teamPatterns && viewItem == developer",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "DevTrace AI",
      "properties": {
        "devtraceai.developerId": {
          "type": "string",
          "description": "Your Developer ID used for logging prompts"
        },
        "devtraceai.teamId": {
          "type": "string",
          "description": "Your Team ID used for access control"
        },
        "devtraceai.enableLogging": {
          "type": "boolean",
          "default": true,
          "description": "Enable prompt logging to DevTrace AI backend"
        },
        "devtraceai.isAdmin": {
          "type": "boolean",
          "default": false,
          "description": "Mark requests as admin for debugging (only set if authorized)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.46.3",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
