{
  "name": "gologchat",
  "displayName": "GoLogChat",
  "description": "Log AI prompts and responses to a team backend for visibility.",
  "version": "0.0.3",
  "publisher": "SushantNadavade",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "prompts",
    "logging",
    "team"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/gologchat.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/gologchat/issues"
  },
  "homepage": "https://github.com/your-org/gologchat",
  "icon": "icon.png",
  "license": "MIT",
  "activationEvents": [
    "onView:gologchat.promptHistory",
    "onView:gologchat.teamPatterns"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gologchat-sidebar",
          "title": "GoLogChat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "gologchat-sidebar": [
        {
          "id": "gologchat.promptHistory",
          "name": "Prompt History",
          "icon": "$(history)",
          "contextualTitle": "GoLogChat"
        },
        {
          "id": "gologchat.teamPatterns",
          "name": "Team Patterns",
          "icon": "$(organization)",
          "contextualTitle": "GoLogChat"
        }
      ]
    },
    "commands": [
      {
        "command": "gologchat.logPrompt",
        "title": "GoLogChat: Log Prompt",
        "icon": "$(add)"
      },
      {
        "command": "gologchat.refreshPrompts",
        "title": "GoLogChat: Refresh Prompts",
        "icon": "$(refresh)"
      },
      {
        "command": "gologchat.filterPrompts",
        "title": "GoLogChat: Filter Prompts",
        "icon": "$(filter)"
      },
      {
        "command": "gologchat.clearFilter",
        "title": "GoLogChat: Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "gologchat.viewPromptDetail",
        "title": "GoLogChat: View Prompt Details",
        "icon": "$(open-preview)"
      },
      {
        "command": "gologchat.editDeveloper",
        "title": "GoLogChat: Edit Developer Profile",
        "icon": "$(edit)"
      },
      {
        "command": "gologchat.refreshTeamPatterns",
        "title": "GoLogChat: Refresh Team Patterns",
        "icon": "$(refresh)"
      },
      {
        "command": "gologchat.showTeamDashboard",
        "title": "GoLogChat: Team Patterns Dashboard",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gologchat.logPrompt",
          "when": "view == gologchat.promptHistory",
          "group": "navigation@1"
        },
        {
          "command": "gologchat.filterPrompts",
          "when": "view == gologchat.promptHistory",
          "group": "navigation@2"
        },
        {
          "command": "gologchat.clearFilter",
          "when": "view == gologchat.promptHistory && gologchat.filterActive",
          "group": "navigation@3"
        },
        {
          "command": "gologchat.refreshPrompts",
          "when": "view == gologchat.promptHistory",
          "group": "navigation@4"
        },
        {
          "command": "gologchat.refreshTeamPatterns",
          "when": "view == gologchat.teamPatterns",
          "group": "navigation@1"
        },
        {
          "command": "gologchat.showTeamDashboard",
          "when": "view == gologchat.teamPatterns",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gologchat.viewPromptDetail",
          "when": "view == gologchat.promptHistory && viewItem == prompt",
          "group": "inline"
        },
        {
          "command": "gologchat.editDeveloper",
          "when": "view == gologchat.teamPatterns && viewItem == developer",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "GoLogChat",
      "properties": {
        "gologchat.apiUrl": {
          "type": "string",
          "default": "https://extension-2n4y.onrender.com",
          "description": "Backend API base URL"
        },
        "gologchat.developerId": {
          "type": "string",
          "description": "Your Developer ID used for logging prompts"
        },
        "gologchat.teamId": {
          "type": "string",
          "description": "Your Team ID used for access control"
        },
        "gologchat.enableLogging": {
          "type": "boolean",
          "default": true,
          "description": "Enable prompt logging to GoLogChat backend"
        },
        "gologchat.isAdmin": {
          "type": "boolean",
          "default": false,
          "description": "Mark requests as admin for debugging (only set if authorized)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.46.3",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
